<Window
    x:Class="Hdr2Sdr.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="hdr2sdr">

    <Grid
        x:Name="RootGrid"
        Background="Transparent"
        KeyDown="RootGrid_KeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom Windows 11 Title Bar -->
        <Grid x:Name="TitleBarGrid" Grid.Row="0" Height="44" Loaded="TitleBarGrid_Loaded" SizeChanged="TitleBarGrid_SizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="CaptionButtonsSpacerColumn" Width="138" />
            </Grid.ColumnDefinitions>

            <!-- Draggable title region -->
            <Grid x:Name="TitleBarDragArea" Grid.Column="0" Background="Transparent" Padding="16,0,8,0">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Image
                        x:Name="TitleBarIcon"
                        Width="18"
                        Height="18"
                        VerticalAlignment="Center" />
                    <TextBlock
                        Text="hdr2sdr"
                        FontSize="13"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    <TextBlock
                        Text="•  HDR / SDR / Luminosité"
                        FontSize="12"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </Grid>

            <!-- Quick header actions (Theme + Options) -->
            <StackPanel
                x:Name="TitleBarActionsPanel"
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="4"
                VerticalAlignment="Center"
                Margin="0,0,6,0">
                <Button
                    x:Name="ThemeButton"
                    Width="32"
                    Height="30"
                    Padding="0"
                    CornerRadius="6"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="ThemeButton_Click"
                    ToolTipService.ToolTip="Basculer thème clair / sombre">
                    <FontIcon
                        x:Name="ThemeIcon"
                        FontFamily="Segoe Fluent Icons"
                        Glyph="&#xE706;"
                        FontSize="14" />
                </Button>
                <Button
                    x:Name="OptionsButton"
                    Width="32"
                    Height="30"
                    Padding="0"
                    CornerRadius="6"
                    Background="Transparent"
                    BorderThickness="1"
                    BorderBrush="Transparent"
                    Click="OptionsButton_Click"
                    ToolTipService.ToolTip="Options">
                    <FontIcon
                        FontFamily="Segoe Fluent Icons"
                        Glyph="&#xE713;"
                        FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Main Home View -->
        <Grid x:Name="HomeView" Grid.Row="1" Padding="18,6,18,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Card 1: HDR / SDR Hero Status & Toggle -->
            <Border
                Grid.Row="0"
                CornerRadius="12"
                Padding="20,16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
                <Grid RowSpacing="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Top pill + Monitor chip -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border
                            x:Name="StatusBadge"
                            Grid.Column="0"
                            CornerRadius="12"
                            Padding="10,4"
                            BorderThickness="1"
                            VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Ellipse x:Name="StatusBadgeDot" Width="7" Height="7" VerticalAlignment="Center" />
                                <TextBlock
                                    x:Name="StatusBadgeText"
                                    Text="SDR"
                                    FontSize="11.5"
                                    FontWeight="SemiBold"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <Border
                            Grid.Column="2"
                            CornerRadius="6"
                            Padding="8,4"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <FontIcon
                                    FontFamily="Segoe Fluent Icons"
                                    Glyph="&#xE7F4;"
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock
                                    x:Name="MonitorChipText"
                                    Text="DISPLAY1"
                                    FontSize="11.5"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextTrimming="CharacterEllipsis"
                                    MaxWidth="210" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Big numeric readout + Mode description + ToggleSwitch -->
                    <Grid Grid.Row="1" ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="102" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="2">
                            <TextBlock
                                x:Name="BigPercentText"
                                Text="50"
                                FontSize="44"
                                FontWeight="SemiBold"
                                LineHeight="48"
                                Typography.NumeralAlignment="Tabular"
                                VerticalAlignment="Bottom"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <TextBlock
                                Text="%"
                                FontSize="18"
                                FontWeight="SemiBold"
                                Margin="2,0,0,7"
                                VerticalAlignment="Bottom"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                            <TextBlock
                                x:Name="ModeTitleText"
                                Text="SDR natif"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <TextBlock
                                x:Name="ModeDescText"
                                Text="Luminosité matérielle via DDC/CI"
                                FontSize="12"
                                TextWrapping="Wrap"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="4">
                            <TextBlock
                                Text="HDR"
                                FontSize="11"
                                FontWeight="SemiBold"
                                HorizontalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <ToggleSwitch
                                x:Name="HdrToggleSwitch"
                                OnContent=""
                                OffContent=""
                                MinWidth="0"
                                Width="42"
                                Padding="0"
                                HorizontalAlignment="Center"
                                Toggled="HdrToggleSwitch_Toggled" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Card 2: Brightness Slider & Step Buttons -->
            <Border
                Grid.Row="2"
                CornerRadius="12"
                Padding="20,16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
                <StackPanel Spacing="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon
                                FontFamily="Segoe Fluent Icons"
                                Glyph="&#xE706;"
                                FontSize="15"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <TextBlock
                                x:Name="BrightnessCardTitle"
                                Text="Luminosité"
                                FontSize="14"
                                FontWeight="SemiBold"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <TextBlock
                                x:Name="NitsChipText"
                                Text=""
                                FontSize="11.5"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </StackPanel>

                        <TextBlock
                            x:Name="SliderValueText"
                            Grid.Column="1"
                            Text="50 %"
                            FontSize="13.5"
                            FontWeight="SemiBold"
                            Typography.NumeralAlignment="Tabular"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    </Grid>

                    <Slider
                        x:Name="BrightnessSlider"
                        Minimum="0"
                        Maximum="100"
                        StepFrequency="1"
                        TickFrequency="10"
                        TickPlacement="None"
                        IsThumbToolTipEnabled="False"
                        ValueChanged="BrightnessSlider_ValueChanged"
                        PointerWheelChanged="BrightnessSlider_PointerWheelChanged" />

                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button
                            x:Name="StepDownButton"
                            Grid.Column="0"
                            HorizontalAlignment="Stretch"
                            Height="36"
                            CornerRadius="8"
                            Click="StepDownButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE738;" FontSize="12" />
                                <TextBlock x:Name="StepDownText" Text="Moins (−5 %)" FontSize="13" FontWeight="Medium" />
                            </StackPanel>
                        </Button>

                        <Button
                            x:Name="StepUpButton"
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            Height="36"
                            CornerRadius="8"
                            Click="StepUpButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE710;" FontSize="12" />
                                <TextBlock x:Name="StepUpText" Text="Plus (+5 %)" FontSize="13" FontWeight="Medium" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Section 3: Quick Profiles -->
            <StackPanel Grid.Row="4" Spacing="10">
                <TextBlock
                    Text="Profils rapides"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Margin="2,0,0,0"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Profile Jour -->
                    <Button
                        x:Name="ProfileJourButton"
                        Grid.Column="0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        VerticalContentAlignment="Stretch"
                        Padding="14,14"
                        CornerRadius="12"
                        BorderThickness="1.5"
                        Click="ProfileJourButton_Click">
                        <StackPanel Spacing="8">
                            <Border
                                x:Name="ProfileJourIconBg"
                                Width="34"
                                Height="34"
                                CornerRadius="8"
                                HorizontalAlignment="Left">
                                <FontIcon
                                    x:Name="ProfileJourIcon"
                                    FontFamily="Segoe Fluent Icons"
                                    Glyph="&#xE706;"
                                    FontSize="16"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Spacing="2">
                                <TextBlock
                                    Text="Jour"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <TextBlock
                                    x:Name="ProfileJourDesc"
                                    Text="SDR natif"
                                    FontSize="11.5"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <!-- Profile Soir -->
                    <Button
                        x:Name="ProfileSoirButton"
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        VerticalContentAlignment="Stretch"
                        Padding="14,14"
                        CornerRadius="12"
                        BorderThickness="1.5"
                        Click="ProfileSoirButton_Click">
                        <StackPanel Spacing="8">
                            <Border
                                x:Name="ProfileSoirIconBg"
                                Width="34"
                                Height="34"
                                CornerRadius="8"
                                HorizontalAlignment="Left">
                                <FontIcon
                                    x:Name="ProfileSoirIcon"
                                    FontFamily="Segoe Fluent Icons"
                                    Glyph="&#xE708;"
                                    FontSize="16"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Spacing="2">
                                <TextBlock
                                    Text="Soir"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <TextBlock
                                    x:Name="ProfileSoirDesc"
                                    Text="HDR • 0 %"
                                    FontSize="11.5"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <!-- Profile Jeu -->
                    <Button
                        x:Name="ProfileJeuButton"
                        Grid.Column="2"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        VerticalContentAlignment="Stretch"
                        Padding="14,14"
                        CornerRadius="12"
                        BorderThickness="1.5"
                        Click="ProfileJeuButton_Click">
                        <StackPanel Spacing="8">
                            <Border
                                x:Name="ProfileJeuIconBg"
                                Width="34"
                                Height="34"
                                CornerRadius="8"
                                HorizontalAlignment="Left">
                                <FontIcon
                                    x:Name="ProfileJeuIcon"
                                    FontFamily="Segoe Fluent Icons"
                                    Glyph="&#xE7FC;"
                                    FontSize="16"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Spacing="2">
                                <TextBlock
                                    Text="Jeu"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <TextBlock
                                    x:Name="ProfileJeuDesc"
                                    Text="HDR • 80 %"
                                    FontSize="11.5"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>

            <!-- Footer status strip -->
            <Grid Grid.Row="6" Margin="2,8,2,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    x:Name="FooterStatusText"
                    Grid.Column="0"
                    Text="Initialisation…"
                    FontSize="12"
                    VerticalAlignment="Center"
                    TextTrimming="CharacterEllipsis"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <TextBlock
                    x:Name="FooterVersionText"
                    Grid.Column="1"
                    Text="v2.0.0"
                    FontSize="11.5"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            </Grid>
        </Grid>

        <!-- Integrated Options View (Windows 11 Settings style) -->
        <Grid x:Name="OptionsView" Grid.Row="1" Visibility="Collapsed" Padding="18,4,18,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Options header -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button
                    Grid.Column="0"
                    Width="36"
                    Height="36"
                    Padding="0"
                    CornerRadius="8"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="BackFromOptionsButton_Click"
                    ToolTipService.ToolTip="Retour (Échap)">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE72B;" FontSize="15" />
                </Button>

                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock
                        Text="Options"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    <TextBlock
                        Text="Écran, profils, démarrage et raccourcis clavier"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>

            <!-- Scrollable Settings Cards -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                <StackPanel Spacing="14" Padding="0,0,4,6">

                    <!-- Group 1: Écran -->
                    <StackPanel Spacing="6">
                        <TextBlock
                            Text="Écran cible"
                            FontSize="12.5"
                            FontWeight="SemiBold"
                            Margin="2,0,0,0"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Border
                            CornerRadius="10"
                            Padding="14,12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox
                                    x:Name="MonitorComboBox"
                                    Grid.Column="0"
                                    HorizontalAlignment="Stretch"
                                    SelectionChanged="MonitorComboBox_SelectionChanged" />
                                <Button
                                    Grid.Column="1"
                                    Width="34"
                                    Height="32"
                                    Padding="0"
                                    CornerRadius="6"
                                    Click="RefreshMonitorsButton_Click"
                                    ToolTipService.ToolTip="Actualiser la liste des écrans">
                                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE72C;" FontSize="13" />
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Group 2: Profils & Pas de luminosité -->
                    <StackPanel Spacing="6">
                        <TextBlock
                            Text="Profils et luminosité"
                            FontSize="12.5"
                            FontWeight="SemiBold"
                            Margin="2,0,0,0"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <Border
                            CornerRadius="10"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                            <StackPanel>
                                <!-- Step % -->
                                <Grid Padding="14,11" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Pas des boutons − / + et raccourcis" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        <TextBlock Text="Incrément de 1 à 25 %" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <NumberBox
                                        x:Name="StepPercentBox"
                                        Grid.Column="1"
                                        Width="104"
                                        Minimum="1"
                                        Maximum="25"
                                        SmallChange="1"
                                        SpinButtonPlacementMode="Compact"
                                        ValueChanged="NumericOption_ValueChanged" />
                                </Grid>

                                <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                <!-- Profil Soir SDR % -->
                                <Grid Padding="14,11" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Profil Soir — contenu SDR" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        <TextBlock Text="Pourcentage appliqué avec HDR ON (0–100 %)" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <NumberBox
                                        x:Name="ProfileSoirBox"
                                        Grid.Column="1"
                                        Width="104"
                                        Minimum="0"
                                        Maximum="100"
                                        SmallChange="5"
                                        SpinButtonPlacementMode="Compact"
                                        ValueChanged="NumericOption_ValueChanged" />
                                </Grid>

                                <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                <!-- Profil Jeu SDR % -->
                                <Grid Padding="14,11" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Profil Jeu — contenu SDR" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        <TextBlock Text="Pourcentage appliqué avec HDR ON (0–100 %)" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <NumberBox
                                        x:Name="ProfileJeuBox"
                                        Grid.Column="1"
                                        Width="104"
                                        Minimum="0"
                                        Maximum="100"
                                        SmallChange="5"
                                        SpinButtonPlacementMode="Compact"
                                        ValueChanged="NumericOption_ValueChanged" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Group 3: Général & Démarrage -->
                    <StackPanel Spacing="6">
                        <TextBlock
                            Text="Général et démarrage"
                            FontSize="12.5"
                            FontWeight="SemiBold"
                            Margin="2,0,0,0"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <Border
                            CornerRadius="10"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                            <StackPanel>
                                <Grid Padding="14,10" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Minimiser dans la zone de notification" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        <TextBlock Text="Fermer ou réduire garde l’app active dans le tray" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <ToggleSwitch
                                        x:Name="MinimizeToTraySwitch"
                                        Grid.Column="1"
                                        OnContent=""
                                        OffContent=""
                                        MinWidth="0"
                                        Width="42"
                                        Toggled="GeneralOption_Toggled" />
                                </Grid>

                                <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                <Grid Padding="14,10" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Démarrer minimisé dans le tray" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        <TextBlock Text="Lance hdr2sdr discrètement en arrière-plan" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <ToggleSwitch
                                        x:Name="StartMinimizedSwitch"
                                        Grid.Column="1"
                                        OnContent=""
                                        OffContent=""
                                        MinWidth="0"
                                        Width="42"
                                        Toggled="GeneralOption_Toggled" />
                                </Grid>

                                <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                <Grid Padding="14,10" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Lancer au démarrage de Windows" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        <TextBlock Text="Ajoute hdr2sdr à la session utilisateur" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <ToggleSwitch
                                        x:Name="StartWithWindowsSwitch"
                                        Grid.Column="1"
                                        OnContent=""
                                        OffContent=""
                                        MinWidth="0"
                                        Width="42"
                                        Toggled="GeneralOption_Toggled" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Group 4: Raccourcis clavier globaux -->
                    <StackPanel Spacing="6">
                        <Grid Margin="2,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                Text="Raccourcis clavier globaux"
                                FontSize="12.5"
                                FontWeight="SemiBold"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <HyperlinkButton
                                Grid.Column="1"
                                Content="Réinitialiser"
                                FontSize="12"
                                Padding="4,0"
                                Click="ResetHotkeysButton_Click" />
                        </Grid>

                        <Border
                            CornerRadius="10"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                            <StackPanel>
                                <Grid Padding="14,10" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Activer les raccourcis clavier" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        <TextBlock Text="Cliquer dans un champ puis presser la combinaison" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <ToggleSwitch
                                        x:Name="HotkeysEnabledSwitch"
                                        Grid.Column="1"
                                        OnContent=""
                                        OffContent=""
                                        MinWidth="0"
                                        Width="42"
                                        Toggled="GeneralOption_Toggled" />
                                </Grid>

                                <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                <StackPanel x:Name="HotkeysFieldsPanel" Padding="14,10" Spacing="8">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="158" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Basculer HDR / SDR" FontSize="12.5" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        <TextBox x:Name="HotkeyToggleBox" Grid.Column="1" Tag="toggle" IsReadOnly="True" PlaceholderText="Aucun" PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                                    </Grid>
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="158" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Luminosité +" FontSize="12.5" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        <TextBox x:Name="HotkeyUpBox" Grid.Column="1" Tag="up" IsReadOnly="True" PlaceholderText="Aucun" PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                                    </Grid>
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="158" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Luminosité −" FontSize="12.5" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        <TextBox x:Name="HotkeyDownBox" Grid.Column="1" Tag="down" IsReadOnly="True" PlaceholderText="Aucun" PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                                    </Grid>
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="158" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Profil Jour" FontSize="12.5" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        <TextBox x:Name="HotkeyJourBox" Grid.Column="1" Tag="jour" IsReadOnly="True" PlaceholderText="Aucun" PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                                    </Grid>
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="158" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Profil Soir" FontSize="12.5" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        <TextBox x:Name="HotkeySoirBox" Grid.Column="1" Tag="soir" IsReadOnly="True" PlaceholderText="Aucun" PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                                    </Grid>
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="158" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Profil Jeu" FontSize="12.5" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        <TextBox x:Name="HotkeyJeuBox" Grid.Column="1" Tag="jeu" IsReadOnly="True" PlaceholderText="Aucun" PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Group 5: Configuration storage -->
                    <Border
                        CornerRadius="10"
                        Padding="14,10"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock x:Name="ConfigModeTitle" Text="Configuration" FontSize="12.5" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <TextBlock x:Name="ConfigPathText" Text="" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Ouvrir le dossier" FontSize="12" CornerRadius="6" Click="OpenConfigFolderButton_Click" />
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
